# --------------------------------------------------
# Public ports on VM
# --------------------------------------------------
FRONTEND_PORT=80
BACKEND_PORT=5000
PYTHON_DOC_PORT=8000
AIRFLOW_WEB_PORT=8091
MLFLOW_PORT=5001
POSTGRES_PORT=5433

# --------------------------------------------------
# Backend (Node)
# --------------------------------------------------
MONGO_URI=
JWT_SECRET=replace-with-strong-random-secret
RAG_TIMEOUT_MS=120000
DEBUG_RAG_PAYLOAD=0
SOCIAL_REFRESH_INTERVAL_MS=21600000
SOCIAL_REFRESH_BATCH_LIMIT=50

# --------------------------------------------------
# Python doc service
# --------------------------------------------------
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
GEMINI_TEMPERATURE=0.2
RUN_QUALITY_CHECKS=false
SPACY_MODEL=en_core_web_sm
EMBEDDING_DIM=768
EMBEDDING_NGRAM_MIN=3
EMBEDDING_NGRAM_MAX=5

# Elasticsearch
ES_ENABLED=true
ES_URLS=https://my-elasticsearch-project-ab7db2.es.us-central1.gcp.elastic.cloud:443
ES_API_KEY=
ES_VERIFY_CERTS=true

# DVC + MLflow + AWS
DVC_AUTO_FLOW_ENABLED=true
DVC_AUTO_PUSH=true
DVC_AUTO_TIMEOUT_SEC=900
MLFLOW_ENABLED=true
MLFLOW_S3_BUCKET=mlflow-custom-care
DVC_S3_BUCKET=dvc-customcare
AWS_DEFAULT_REGION=us-west-2
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=

# --------------------------------------------------
# Shared Postgres (Airflow + MLflow)
# --------------------------------------------------
POSTGRES_SUPERUSER=postgres
POSTGRES_SUPERPASSWORD=postgres
POSTGRES_SUPERDB=postgres

# --------------------------------------------------
# Airflow DB + Admin
# --------------------------------------------------
AIRFLOW_DB_USER=airflow
AIRFLOW_DB_PASSWORD=airflow
AIRFLOW_DB_NAME=airflow
AIRFLOW_UID=50000
AIRFLOW_FERNET_KEY=
AIRFLOW_ADMIN_USERNAME=airflow
AIRFLOW_ADMIN_PASSWORD=change-me
AIRFLOW_ADMIN_EMAIL=airflow@example.com

# DAG defaults (optional)
AIRFLOW_ML_CLIENT_ID=
AIRFLOW_ML_BOT_ID=
AIRFLOW_ML_SERVICE_URL=http://python-doc-service:8000
AIRFLOW_HDBSCAN_REBUILD_MODE=full
AIRFLOW_HDBSCAN_PDF_MANIFEST=data/dvc/pdf_manifest.json
AIRFLOW_DEPLOY_CMD=echo deploy_skipped
AIRFLOW_AUTOCOMPLETE_DAG_ID=autocomplete_pipeline
AIRFLOW_HDBSCAN_DAG_ID=hdbscan_pipeline
AIRFLOW_AUTOTRIGGER_ENABLED=true

# --------------------------------------------------
# MLflow DB
# --------------------------------------------------
MLFLOW_DB_USER=mlflow
MLFLOW_DB_PASSWORD=mlflow
MLFLOW_DB_NAME=mlflow
