# --------------------------------------------------
# Shared Postgres
# --------------------------------------------------
POSTGRES_SUPERUSER=postgres
POSTGRES_SUPERPASSWORD=postgres
POSTGRES_SUPERDB=postgres
POSTGRES_PORT=5433

# --------------------------------------------------
# Airflow DB + Admin
# --------------------------------------------------
AIRFLOW_DB_USER=airflow
AIRFLOW_DB_PASSWORD=airflow
AIRFLOW_DB_NAME=airflow

AIRFLOW_UID=50000
AIRFLOW_WEB_PORT=8091
AIRFLOW_FERNET_KEY=
AIRFLOW_ADMIN_USERNAME=airflow
AIRFLOW_ADMIN_PASSWORD=airflow
AIRFLOW_ADMIN_EMAIL=airflow@example.com

# DAG runtime values (optional defaults)
AIRFLOW_ML_CLIENT_ID=
AIRFLOW_ML_BOT_ID=
AIRFLOW_ML_SERVICE_URL=http://host.docker.internal:8000
AIRFLOW_HDBSCAN_REBUILD_MODE=full
AIRFLOW_HDBSCAN_PDF_MANIFEST=data/dvc/pdf_manifest.json
AIRFLOW_DEPLOY_CMD=echo deploy_skipped

# --------------------------------------------------
# MLflow DB + Server
# --------------------------------------------------
MLFLOW_DB_USER=mlflow
MLFLOW_DB_PASSWORD=mlflow
MLFLOW_DB_NAME=mlflow
MLFLOW_PORT=5001

# Your S3 bucket for MLflow artifacts
MLFLOW_S3_BUCKET=mlflow-custom-care
AWS_DEFAULT_REGION=us-west-2
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=

# --------------------------------------------------
# App Integration Targets (for reference)
# --------------------------------------------------
# Your Elasticsearch endpoint
ES_URLS=https://my-elasticsearch-project-ab7db2.es.us-central1.gcp.elastic.cloud:443
# Keep secret out of git and set in real env only
ES_API_KEY=

# Your DVC bucket
DVC_S3_BUCKET=dvc-customcare
