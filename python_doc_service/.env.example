# ------------------------------------------------------------------
# LLM
# ------------------------------------------------------------------
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
GEMINI_TEMPERATURE=0.2

# Optional if you enable OpenAI paths
# OPENAI_API_KEY=
# OPENAI_MODEL=gpt-4.1
# OPENAI_TEMPERATURE=0.2

# ------------------------------------------------------------------
# Runtime paths
# ------------------------------------------------------------------
SCRAPED_PDF_DIR=/tmp/pdfs
RUN_QUALITY_CHECKS=false

# ------------------------------------------------------------------
# Elasticsearch hybrid retrieval
# ------------------------------------------------------------------
ES_ENABLED=true
# Provided endpoint
ES_URLS=https://my-elasticsearch-project-ab7db2.es.us-central1.gcp.elastic.cloud:443
ES_API_KEY=
ES_USERNAME=
ES_PASSWORD=
ES_VERIFY_CERTS=true
ES_CA_CERTS=
ES_REQUEST_TIMEOUT_SEC=5
ES_PING_TIMEOUT_SEC=1
ES_COOLDOWN_SECONDS=20
ES_CHUNK_INDEX=bot_chunks_hybrid_v1
ES_QUESTION_INDEX=bot_questions_hybrid_v1
HYBRID_SEMANTIC_WEIGHT=0.45
HYBRID_BM25_WEIGHT=0.55
AUTOCOMPLETE_MODEL_WEIGHT=0.35
AUTOCOMPLETE_ES_WEIGHT=0.65

# ------------------------------------------------------------------
# Autocomplete tuning
# ------------------------------------------------------------------
AUTOCOMPLETE_RECENCY_BOOST=3.6
AUTOCOMPLETE_RECENCY_POWER=2.4
AUTOCOMPLETE_SEED_WEIGHT=0.45
AUTOCOMPLETE_RECENT_USER_WINDOW=40
AUTOCOMPLETE_RECENT_USER_MULTIPLIER=1.55
AUTOCOMPLETE_ULTRA_RECENT_WINDOW=12
AUTOCOMPLETE_ULTRA_RECENT_MULTIPLIER=1.18
AUTOCOMPLETE_SEMANTIC_DEDUPE_THRESHOLD=0.82
AUTOCOMPLETE_SEMANTIC_DEDUPE_WINDOW=180
AIRFLOW_QUEUE_TTL_SEC=900

# ------------------------------------------------------------------
# DVC automation
# ------------------------------------------------------------------
DVC_AUTO_FLOW_ENABLED=true
DVC_AUTO_PUSH=false
DVC_AUTO_TIMEOUT_SEC=900
# S3 remote to configure via `python -m dvc remote add`
# Example: s3://dvc-customcare/adv_project/dvc

# ------------------------------------------------------------------
# Airflow trigger integration
# Set AIRFLOW_AUTOTRIGGER_ENABLED=false until Airflow is live.
# ------------------------------------------------------------------
AIRFLOW_AUTOTRIGGER_ENABLED=false
AIRFLOW_API_BASE_URL=https://<your-airflow-host>
AIRFLOW_API_HOST=
AIRFLOW_API_PORT=
AIRFLOW_API_TIMEOUT_SEC=20
AIRFLOW_API_TOKEN=
AIRFLOW_API_USERNAME=
AIRFLOW_API_PASSWORD=
AIRFLOW_AUTOCOMPLETE_DAG_ID=autocomplete_pipeline
AIRFLOW_HDBSCAN_DAG_ID=hdbscan_pipeline

# ------------------------------------------------------------------
# MLflow tracking
# ------------------------------------------------------------------
MLFLOW_ENABLED=true
MLFLOW_TRACKING_URI=http://<mlflow-host>:5000
MLFLOW_TRACKING_HOST=
MLFLOW_TRACKING_PORT=
MLFLOW_EXPERIMENT_PIPELINE=bot-pipeline
MLFLOW_EXPERIMENT_AUTOCOMPLETE=bot-autocomplete

# ------------------------------------------------------------------
# Monitoring thresholds
# ------------------------------------------------------------------
MODEL_MONITORING_ENABLED=true
HDBSCAN_DRIFT_THRESHOLD=0.35
AUTOCOMPLETE_DRIFT_THRESHOLD=0.35
AUTOCOMPLETE_MIN_CONFIDENCE=0.35

# ------------------------------------------------------------------
# Crawl/social limits
# ------------------------------------------------------------------
WEBSITE_CRAWL_MAX_PAGES=25
WEBSITE_CRAWL_TIMEOUT=10
WEBSITE_CRAWL_MAX_BYTES=2000000
WEBSITE_TEXT_LIMIT=100000
WEBSITE_LOG_PREVIEW_CHARS=400
WEBSITE_RENDER_TIMEOUT_MS=25000
WEBSITE_SCROLL_PASSES=2
WEBSITE_USE_PLAYWRIGHT=true
WEBSITE_RENDER_WAIT_MS=2500
WEBSITE_RENDER_EXTRA_WAIT_MS=3500

SOCIAL_LOG_PREVIEW_CHARS=400
SOCIAL_TEXT_LIMIT=50000
SOCIAL_RENDER_TIMEOUT_MS=35000
SOCIAL_SCROLL_PASSES=1
SOCIAL_USE_PLAYWRIGHT=true
SOCIAL_RENDER_WAIT_MS=3000
SOCIAL_RENDER_EXTRA_WAIT_MS=5000
SOCIAL_INTENT_DOUBTFUL_THRESHOLD=0.55
SOCIAL_INDEX_TTL_SEC=21600
SOCIAL_REFRESH_TIMEOUT_SEC=15
SOCIAL_TOOL_LIVE_FALLBACK=false

# Experience similarity
EXPERIENCE_MIN_SIMILARITY=0.72
